# Copy to .env for local development. Never commit real secrets.
BIZAGENT_ENV=development
BIZAGENT_SECRET_KEY=replace-with-a-long-random-secret
BIZAGENT_PUBLIC_URL=http://localhost:8000

# Local SQLite is the default when DATABASE_URL is empty.
DATABASE_URL=

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
BIZAGENT_LLM_ORDER=gemini,groq,cerebras,openrouter
TAVILY_API_KEY=

BIZAGENT_SCAN_SEARCH_CONCURRENCY=3
# How many LLM calls the risk scan may run in parallel (1-8). Small on purpose:
# free-tier rate limits are easy to self-inflict. Parallel calls cut scan time
# without changing any prompt or result.
BIZAGENT_LLM_CONCURRENCY=3
# Per-call HTTP timeout (seconds) for every LLM provider, so one hung request
# can never stall a scan.
BIZAGENT_LLM_TIMEOUT_SECONDS=60
BIZAGENT_UPLOAD_MAX_BYTES=10485760
